# Copy to .env (or export directly) before running the bot.

# --- identity, shown at GET /v1/metadata ---
TEAM_NAME=your-team-name
TEAM_MEMBERS=Alice,Bob
CONTACT_EMAIL=you@example.com
SUBMITTED_AT=2026-04-29T08:00:00Z

# --- composer mode ---
# "template" (default) = deterministic, no external calls, no key required.
# "llm"                = calls an LLM at temperature=0 for composition, falling
#                        back to "template" automatically on any failure.
COMPOSER_MODE=template

# only needed if COMPOSER_MODE=llm
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-4-1-20250805
LLM_TIMEOUT_SECONDS=20

# server port (also read directly by `python bot.py`)
PORT=8080
